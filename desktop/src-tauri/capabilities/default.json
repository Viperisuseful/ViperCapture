{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal core permissions for the ViperCapture main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "mobile-capture:allow-capture",
    "mobile-capture:allow-save",
    "mobile-capture:allow-open-downloads",
    "mobile-capture:allow-open-external"
  ]
}
