[
  {
    "name": "example-viewport",
    "request": {
      "url": "https://example.com",
      "output": "png",
      "viewport": {"width": 1280, "height": 720, "device_scale_factor": 1},
      "full_page": false,
      "lazy_load": "none",
      "wait_for": {"event": "load"}
    }
  },
  {
    "name": "example-full-page",
    "request": {
      "url": "https://example.org",
      "output": "png",
      "viewport": {"width": 1440, "height": 900, "device_scale_factor": 1},
      "full_page": true,
      "lazy_load": "adaptive",
      "wait_for": {"event": "load"}
    }
  }
]
