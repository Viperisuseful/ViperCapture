VIPERCAPTURE_VERSION=v0.2.0-beta.2
VIPERCAPTURE_GATEWAY_PORT=8080
VIPERCAPTURE_PUBLIC_URL=https://capture.example.com

# Generate every value independently, for example with: openssl rand -hex 32
VIPERCAPTURE_ADMIN_TOKEN=replace-me
VIPERCAPTURE_CONTROL_SECRET=replace-me
VIPERCAPTURE_JOB_SECRET=replace-me
VIPERCAPTURE_SIGNING_SECRET=replace-me
VIPERCAPTURE_SIGNING_ADMIN_TOKEN=replace-me
VIPERCAPTURE_WEBHOOK_SECRET=replace-me

VIPERCAPTURE_S3_BUCKET=vipercapture-production
VIPERCAPTURE_S3_REGION=auto
VIPERCAPTURE_S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
VIPERCAPTURE_S3_ADDRESSING_STYLE=path
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
